# AURA — variables d'environnement (exemple, aucun secret réel)
# Copiez ce fichier en .env (jamais committé) et renseignez vos valeurs.
# Les clés API sont lues UNIQUEMENT côté serveur : jamais de préfixe VITE_,
# jamais dans le frontend, jamais dans Git.

# ── Clés API des fournisseurs IA (ajoutées manuellement, après la mission) ──
# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# ── Configuration du système IA ──
# Fournisseur par défaut : auto (défaut) | gemini | groq | openrouter
# (mock = tests automatisés uniquement)
AI_DEFAULT_PROVIDER=auto

# Ordre de repli — priorité déterministe du routeur (défaut : gemini,groq,openrouter)
AI_FALLBACK_ORDER=gemini,groq,openrouter

# Tentatives supplémentaires après le premier fournisseur (défaut : 2)
AI_MAX_RETRIES=2

# Délai maximal d'une requête fournisseur, en ms (défaut : 60000)
AI_REQUEST_TIMEOUT_MS=60000

# ── Modèles (ajustables sans toucher au code métier) ──
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Modèle de recherche sourcée (grounding Gemini) :
# GEMINI_SEARCH_MODEL=

# ── Points d'entrée API (tests / proxys — valeurs par défaut officielles) ──
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# GROQ_API_BASE=https://api.groq.com/openai/v1
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# ── Alias historiques (toujours acceptés, à remplacer progressivement) ──
# AURA_GEMINI_API_KEY → GEMINI_API_KEY
# AURA_MODELE         → GEMINI_MODEL
# AURA_MODELE_URL     → GEMINI_API_BASE
# AURA_AI_PROVIDER    → AI_DEFAULT_PROVIDER
# AURA_MODELE_RECHERCHE → GEMINI_SEARCH_MODEL

# ── Stockage ──
# Production Vercel : Vercel KV (Upstash) — variables automatiques du
# marketplace, ou manuelles :
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (alias supportés : AURA_KV_URL / AURA_KV_TOKEN)

# Auto-hébergement / dev : dossier de données local (JSON atomique)
# AURA_DATA_DIR=./data

# ── Confiance proxy (sécurité) ──
# À poser UNIQUEMENT derrière un proxy de confiance (un seul saut).
# Sur Vercel, la confiance est déjà réglée automatiquement par la plateforme.
# Sans proxy, aucune confiance n'est accordée à l'en-tête x-forwarded-for.
# AURA_TRUST_PROXY=1

# ── E-mails transactionnels (vérification d'adresse, mot de passe oublié) ──
# Deux fournisseurs, appelés en REST (aucun paquet ajouté) :
#
#   resend : exige un DOMAINE vérifié (donc un domaine payant). Avec
#            « onboarding@resend.dev », les messages ne partent que vers
#            l'adresse du titulaire du compte.
#   brevo  : aucun domaine nécessaire — on valide une simple ADRESSE
#            d'expédition (lien reçu dans cette boîte). Offre gratuite
#            permanente : 300 messages/jour, sans carte bancaire.
#
# Sans configuration COMPLÈTE, les routes concernées répondent 503
# « mail-indisponible » : aucun e-mail n'est jamais simulé.
# AURA_MAIL_PROVIDER=resend
# AURA_MAIL_PROVIDER=brevo
# Brevo : clé « SMTP & API → API keys » (commence par xkeysib-).
# Resend : clé « API Keys » (commence par re_).
# AURA_MAIL_API_KEY=
# Expéditeur au format « AURA <bonjour@votredomaine.tld> ».
#   · Resend : le domaine doit être vérifié chez Resend.
#   · Brevo  : l'adresse doit être validée dans « Senders » (une adresse
#              Gmail suffit — la validation se fait par un lien reçu).
# AURA_MAIL_FROM=
# AURA_MAIL_REPLY_TO=support@votredomaine.tld
# Origine publique utilisée pour construire les liens des e-mails.
# Obligatoire : jamais déduite de l'en-tête Host d'une requête.
# AURA_PUBLIC_ORIGIN=https://aura.example
# Point d'entrée et délai. Par défaut, selon le fournisseur :
#   resend → https://api.resend.com      brevo → https://api.brevo.com/v3
# Ne jamais ajouter de sous-chemin : le code ajoute /emails (Resend) ou
# /smtp/email (Brevo).
# AURA_MAIL_API_URL=https://api.resend.com
# AURA_MAIL_TIMEOUT_MS=8000

# Confirmation d'adresse obligatoire avant l'accès à l'espace.
# Absente  : obligatoire dès qu'un fournisseur d'e-mails est configuré,
#            « impossible » sinon (accès ouvert, l'interface le dit).
# =1       : obligatoire même sans fournisseur ; l'inscription répond alors
#            503 « mail-indisponible » plutôt que de créer un compte qui ne
#            pourrait jamais être confirmé.
# =0       : facultative (bandeau informatif seulement).
# AURA_VERIFICATION_EMAIL_OBLIGATOIRE=

# ── Durées de vie des jetons (bornées, appliquées côté serveur) ──
# Vérification d'adresse : 1 à 168 heures (défaut 24).
# AURA_JETON_VERIFICATION_HEURES=24
# Réinitialisation de mot de passe : 5 à 120 minutes (défaut 30).
# AURA_JETON_REINITIALISATION_MINUTES=30

# ── Divers ──
# NODE_ENV=development
# PORT=3000
