# GEMINI_API_KEY: Clé API principale pour Gemini & moteurs natifs Aura (injectée automatiquement par AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publique de la plateforme Aura
APP_URL="MY_APP_URL"

# Fournisseurs IA additionnels (Optionnel — Architecture Multi-Fournisseurs)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Persistance PostgreSQL Supabase (Recommandé pour la production sur Vercel)
# Renseignez l'URL de votre projet Supabase et votre clé Service Role (ou Anon Key)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# Secret de signature des jetons de session (Optionnel)
AURA_SESSION_SECRET=""

# Limite quotidienne de requêtes sur l'offre gratuite (Contrôle côté serveur)
AURA_DAILY_QUOTA="50"
