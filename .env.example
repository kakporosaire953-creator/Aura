# AURA — variables d'environnement (exemple, aucun secret réel)
# Copiez ce fichier en .env (jamais committé) et renseignez vos valeurs.
# Les clés API sont lues UNIQUEMENT côté serveur : jamais de préfixe VITE_,
# jamais dans le frontend, jamais dans Git.

# ── Clés API des fournisseurs IA (ajoutées manuellement, après la mission) ──
# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# ── Configuration du système IA ──
# Fournisseur par défaut : auto (défaut) | gemini | groq | openrouter
# (mock = tests automatisés uniquement)
AI_DEFAULT_PROVIDER=auto

# Ordre de repli — priorité déterministe du routeur (défaut : gemini,groq,openrouter)
AI_FALLBACK_ORDER=gemini,groq,openrouter

# Tentatives supplémentaires après le premier fournisseur (défaut : 2)
AI_MAX_RETRIES=2

# Délai maximal d'une requête fournisseur, en ms (défaut : 60000)
AI_REQUEST_TIMEOUT_MS=60000

# ── Modèles (ajustables sans toucher au code métier) ──
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Modèle de recherche sourcée (grounding Gemini) :
# GEMINI_SEARCH_MODEL=

# ── Points d'entrée API (tests / proxys — valeurs par défaut officielles) ──
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# GROQ_API_BASE=https://api.groq.com/openai/v1
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# ── Alias historiques (toujours acceptés, à remplacer progressivement) ──
# AURA_GEMINI_API_KEY → GEMINI_API_KEY
# AURA_MODELE         → GEMINI_MODEL
# AURA_MODELE_URL     → GEMINI_API_BASE
# AURA_AI_PROVIDER    → AI_DEFAULT_PROVIDER
# AURA_MODELE_RECHERCHE → GEMINI_SEARCH_MODEL

# ── Stockage ──
# Production Vercel : Vercel KV (Upstash) — variables automatiques du
# marketplace, ou manuelles :
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (alias supportés : AURA_KV_URL / AURA_KV_TOKEN)

# Auto-hébergement / dev : dossier de données local (JSON atomique)
# AURA_DATA_DIR=./data

# ── Divers ──
# NODE_ENV=development
# PORT=3000
