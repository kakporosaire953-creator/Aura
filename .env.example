# GEMINI_API_KEY: Clé API principale pour Gemini (injectée automatiquement par AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publique de la plateforme Aura
APP_URL="MY_APP_URL"

# Fournisseurs IA additionnels (Optionnel — Architecture Multi-Fournisseurs)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Persistance & Authentification externe (Optionnel — Supabase PostgreSQL & Auth)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Limite quotidienne de requêtes sur l'offre gratuite (Contrôle côté serveur)
AURA_DAILY_QUOTA="50"
