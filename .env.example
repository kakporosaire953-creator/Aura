# AURA — variables d'environnement (exemple, aucun secret réel)
# Copiez ce fichier en .env (jamais committé) et renseignez vos valeurs.

# ── Moteur IA (serveur uniquement — jamais préfixé VITE_) ──
# Clé API Google AI Studio (Gemini). Requise pour l'assistant, le studio
# et la recherche sourcée.
GEMINI_API_KEY=

# Modèle optionnel (défaut : gemini-3.8-flash)
# AURA_MODELE=gemini-3.8-flash
# Base URL surchargeable (tests / proxys)
# AURA_MODELE_URL=https://generativelanguage.googleapis.com

# Sélection du fournisseur IA : auto (défaut) | mock (tests uniquement)
# AURA_AI_PROVIDER=auto

# ── Stockage ──
# Production Vercel : Vercel KV (Upstash) — variables automatiques du
# marketplace, ou manuelles :
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (alias supportés : AURA_KV_URL / AURA_KV_TOKEN)

# Auto-hébergement / dev : dossier de données local (JSON atomique)
# AURA_DATA_DIR=./data

# ── Divers ──
# NODE_ENV=development
# PORT=3000
