{
  "name": "aura",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server.ts",
    "verif:prod": "npm run build && node scripts/verifier-prod.cjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "simple-icons": "^16.35.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
